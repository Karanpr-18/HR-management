# =================================================================
# TalentAI HR Platform - Environment Configuration Example
# Copy this file to .env and configure your production values
# =================================================================

# -----------------------------------------------------------------
# 1. Flask & Core Server Configuration
# -----------------------------------------------------------------
PORT=5000
DEBUG=false
FLASK_ENV=production

# CRITICAL FOR PRODUCTION: Set a strong random secret key for session signing
# You can generate one with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------
# 2. File Upload & Storage Configuration
# -----------------------------------------------------------------
# Maximum upload payload size in bytes (16MB = 16777216)
MAX_CONTENT_LENGTH=16777216

# Directory for file and resume uploads
UPLOAD_FOLDER=uploads

# Path to application data JSON store
DATA_FILE=data.json

# -----------------------------------------------------------------
# 3. AI / LLM Provider Configuration
# -----------------------------------------------------------------
# Google Gemini API Key (primary engine for candidate resume extraction & scoring)
GEMINI_API_KEY=

# Groq API Key (high-speed fallback engine for resume extraction)
GROQ_API_KEY=

# OpenAI API Key (optional fallback / legacy integration)
OPENAI_API_KEY=

# -----------------------------------------------------------------
# 4. Email & Notification SMTP Configuration
# -----------------------------------------------------------------
# If SMTP_HOST is left blank, notification emails will be previewed to stdout
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=recruitment@talentai.local
SMTP_USE_TLS=true
